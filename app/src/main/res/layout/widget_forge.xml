<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_kicker" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="FORGE" android:textColor="#FF6A33" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12" />
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Open Forge" android:textColor="#F2F0EA" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#8B909B" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="bottom|center_vertical" android:layout_marginTop="8dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/w_ready" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#2FD3A8" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="READY" android:textColor="#5B606B" android:textSize="9sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
            <TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFC94A" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WK STREAK" android:textColor="#5B606B" android:textSize="9sp" android:textStyle="bold" />
        </LinearLayout>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/w_btn" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Start" android:textColor="#1A0B04" android:textSize="14sp" android:textStyle="bold"
            android:background="@drawable/widget_btn" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" />
    </LinearLayout>
</LinearLayout>
